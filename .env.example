# TopGameAI Competition Environment Configuration
# Copy this file to .env and supply your credentials

# Team credentials
AGENT_NAME=ProgrammablePros
TOPGAMEAI_BASE_URL=https://topgameai.com/api
TOPGAMEAI_API_KEY=your_topgameai_api_key_here

# Legacy env aliases
TOPGAME_API_URL=https://topgameai.com/api
TOPGAME_API_KEY=your_topgameai_api_key_here

# Laya Inference Configuration
LAYA_MODE=mock  # mock | http | local
LAYA_ENDPOINT=https://api.laya.ai/v1
LAYA_API_KEY=your_laya_api_key_here
LAYA_MODEL_PATH=

# Hypothesis Generation Mode
HYPOTHESIS_MODE=full  # full | lean

# Step Ledger Policy: repeat_last_applied (Default) | pending_ordinal
REJECTED_STEP_POLICY=repeat_last_applied

# Directory Paths
LOG_ROOT=logs
QUARANTINE_DIR=logs/_mock
